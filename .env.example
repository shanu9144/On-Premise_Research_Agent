# Copy the lines you need into .env (never commit .env). Environment variables override .env.

# Exa: key from https://dashboard.exa.ai/api-keys. Exa stays disabled until both budgets are above 0 (USD).
EXA_API_KEY=
EXA_DAILY_BUDGET=0.10
EXA_MONTHLY_BUDGET=2.00
EXA_RESERVE=0.20

# Optional. Without TAVILY_API_KEY, Tavily's rate-limited keyless search is used (10/day, 100/month locally).
TAVILY_API_KEY=
TAVILY_DAILY_BUDGET=0
TAVILY_MONTHLY_BUDGET=0

FIRECRAWL_API_KEY=
FIRECRAWL_DAILY_BUDGET=0
FIRECRAWL_MONTHLY_BUDGET=0

# Language model. With GROQ_API_KEY set, Groq is used (free tier, works when deployed); otherwise local Ollama.
# Key from https://console.groq.com/keys. Optional: LLM_PROVIDER=groq|ollama, GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Deployment only. Leave unset locally to keep history in .research_agent/history.sqlite3.
# Turso (free hosted SQLite) keeps history when a free host restarts: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Allowed frontend origins (comma separated, no trailing slash), e.g. https://fieldnotes.vercel.app
CORS_ORIGINS=
# Optional per-IP limits for /search (defaults: 3 per minute, 30 per day)
SEARCH_LIMIT_PER_MINUTE=3
SEARCH_LIMIT_PER_DAY=30
# Optional extra input check using Groq's free Prompt Guard 2 (on/off). Off by default: it flags some legitimate security questions.
PROMPT_GUARD=off
